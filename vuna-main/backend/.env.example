# Copy to .env for local development. Never commit real values.

# ── Django ────────────────────────────────────────────────────────────────────
# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
# Comma-separated. Render's own hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (Render provides DATABASE_URL in production; SQLite is used if empty)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── Browsers allowed to call the API directly (comma-separated) ───────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173
# Production only: origins allowed to POST to Django admin
# CSRF_TRUSTED_ORIGINS=https://vuna-main.onrender.com

# ── Cloudinary (required when DEBUG is off) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── M-Pesa Express (Daraja). Leave MPESA_ENV empty for simulated payments ─────
# MPESA_ENV=sandbox            # or "production" once Safaricom approves go-live
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379       # sandbox shortcode; your paybill/till in production
# MPESA_PASSKEY=
# MPESA_CALLBACK_TOKEN=        # long random string, part of the callback URL
# MPESA_CALLBACK_BASE=         # public backend URL; on Render RENDER_EXTERNAL_URL is used automatically

# ── First admin, created on deploy by `manage.py seed_admin` (build.sh) ────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD=              # at least 12 characters; change it after first sign-in
