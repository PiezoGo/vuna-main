# Copy to .env.local. Never commit real values.

# Server only: where Next.js reaches Django (include the trailing /api).
API_URL=http://127.0.0.1:8000/api

# Public (shipped to the browser, never put secrets here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Live updates (notifications, chat). The backend's websocket address; leave empty to fall back
# to a check every 60 seconds. Production: wss://<your-render-service>.onrender.com/ws/
# Locally the backend must run under uvicorn for this to work:
#   uvicorn backend.asgi:application --port 8000
NEXT_PUBLIC_WS_URL=
